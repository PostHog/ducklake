# name: test/sql/metadata/maintenance_snapshot_reads_keep_ducklake_tx.test
# description: Maintenance snapshot reads should still use DuckLake's explicit metadata transaction path
# group: [metadata]

require ducklake

require parquet

test-env DUCKLAKE_CONNECTION __TEST_DIR__/{UUID}.db

test-env DATA_PATH __TEST_DIR__

statement ok
ATTACH 'ducklake:${DUCKLAKE_CONNECTION}' AS ducklake (DATA_PATH '${DATA_PATH}/ducklake_maintenance_snapshot_reads_keep_tx', DATA_INLINING_ROW_LIMIT 10)

statement ok
CREATE TABLE ducklake.test_tbl(id INTEGER, payload VARCHAR)

statement ok
INSERT INTO ducklake.test_tbl VALUES (1, 'a'), (2, 'b'), (3, 'c')

statement ok
CALL enable_logging('DuckLakeMetadata')

query II
SELECT table_name, rows_flushed FROM ducklake_flush_inlined_data('ducklake') ORDER BY ALL
----
test_tbl	3

query I
SELECT count(*) > 0
FROM duckdb_logs_parsed('DuckLakeMetadata')
WHERE metadata_api = 'SnapshotQuery'
  AND ducklake_explicit_metadata_transaction
  AND query LIKE '%ducklake_inlined_data%'
----
true

statement ok
DELETE FROM ducklake.test_tbl WHERE id = 1

statement ok
CALL ducklake_flush_inlined_data('ducklake')

query III
SELECT table_name, files_processed, files_created FROM ducklake_rewrite_data_files('ducklake', 'test_tbl', delete_threshold => 0) ORDER BY ALL
----
test_tbl	1	1

query I
SELECT count(*) > 0
FROM duckdb_logs_parsed('DuckLakeMetadata')
WHERE metadata_api = 'CurrentQuery'
  AND ducklake_explicit_metadata_transaction
  AND query LIKE '%ducklake_data_file%'
  AND query LIKE '%ducklake_delete_file%'
----
true

statement ok
CALL ducklake_expire_snapshots('ducklake', older_than => now())

query I
SELECT count(*) > 0 FROM ducklake_cleanup_old_files('ducklake', dry_run => true, cleanup_all => true)
----
true

query I
SELECT count(*) > 0
FROM duckdb_logs_parsed('DuckLakeMetadata')
WHERE metadata_api = 'CurrentQuery'
  AND ducklake_explicit_metadata_transaction
  AND query LIKE '%ducklake_files_scheduled_for_deletion%'
----
true
